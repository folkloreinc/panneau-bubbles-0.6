{
	"name": "panneau/bubbles",
    "description": "A bubbles management addon for Panneau",
    "keywords": ["panneau", "cms", "dashboard", "bubbles", "content management", "admin", "administration", "media"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=5.5.9",
        "illuminate/support": "5.2.*",
		"panneau/panneau": "0.4.*",
        "rtconner/laravel-tagging": "~2.0",
        "folklore/eloquent-mediatheque": "5.2.*",
		"baum/baum": "~1.1"
    },
    "require-dev": {
        "orchestra/testbench": "~3.2"
    },
    "autoload": {
        "psr-0": {
            "Panneau\\Bubbles\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
